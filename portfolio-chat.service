[Unit]
Description=Portfolio Chat Server
After=network.target ollama.service

[Service]
Type=simple
User=kellogg
WorkingDirectory=/home/kellogg/dev/portfolio_chat
Environment=PATH=/home/kellogg/dev/portfolio_chat/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/kellogg/dev/portfolio_chat/.venv/bin/python -m portfolio_chat.server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
